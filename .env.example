# dsh-hindsight-memory — copy to .env (the plugin also generates .env from the settings panel).
# Local Hindsight (hindsight-api-slim 1.1.0) needs a REMOTE embedding provider and an LLM key
# (or HINDSIGHT_API_LLM_PROVIDER=none for chunk-only storage).
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=BAAI/bge-m3
# 1.1.0 accepts rrf (passthrough); "none" is rejected.
HINDSIGHT_API_RERANKER_PROVIDER=rrf
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com
HINDSIGHT_API_LLM_MODEL=deepseek-flash
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_DATABASE_URL=pg0://dsh-hindsight
HINDSIGHT_API_PORT=8888
# Optional pip/uv mirror used for installation:
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
